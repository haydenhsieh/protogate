# LinkIt 7697: onboard Silicon Labs CP2102N USB-to-UART adapter.
# Match this board's USB serial number; grant the active local user access.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0001", GROUP="dialout", MODE="0660", TAG+="uaccess", SYMLINK+="linkit7697", ENV{ID_MM_DEVICE_IGNORE}="1"
